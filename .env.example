# Diseñador Web Definitivo — Variables de entorno
# Copia este archivo como .env y completa tus API keys:
#   cp .env.example .env

# --- NanoBanana MCP (Gemini) ---
# Obtén tu key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google Stitch MCP ---
# Tu Google Cloud Project ID (ej: mi-proyecto-123456)
GOOGLE_CLOUD_PROJECT=

# --- 21st Dev Magic ---
# Obtén tu key en: https://21st.dev (sección API keys)
DEV21ST_API_KEY=
